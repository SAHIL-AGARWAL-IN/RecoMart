# Copy this file to .env and adjust values.  (PowerShell: Copy-Item .env.example .env)

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Live server only (see docs/DEPLOY.md). Leave these as they are on your laptop.
# HTTPS=True: secure cookies, HSTS and a redirect to https://. Set SSL_REDIRECT=False when the
# host already redirects (PythonAnywhere's "Force HTTPS").
HTTPS=False
SSL_REDIRECT=True
# Full origins allowed to submit forms, comma-separated, e.g. https://yourname.pythonanywhere.com
CSRF_TRUSTED_ORIGINS=
# Public portfolio demo: one-click demo logins; the shared demo accounts can look but not change things.
DEMO_MODE=False

# Database: leave DB_ENGINE empty for SQLite (development).
# Set DB_ENGINE=postgres and fill the rest to use PostgreSQL (also: pip install "psycopg[binary]").
DB_ENGINE=
DB_NAME=recomart
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
