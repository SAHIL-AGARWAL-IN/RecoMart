# Copy this file to .env and adjust values.  (PowerShell: Copy-Item .env.example .env)

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database: leave DB_ENGINE empty for SQLite (development).
# Set DB_ENGINE=postgres and fill the rest to use PostgreSQL (also: pip install "psycopg[binary]").
DB_ENGINE=
DB_NAME=recomart
DB_USER=postgres
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=5432
